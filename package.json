{
  "name": "normal-cage-baker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "asc assembly/index.ts --outFile public/baker.wasm --runtime stub --optimize --noAssert",
    "build:meshes": "node scripts/export-meshes.mjs",
    "build": "npm run build:wasm && npm run build:meshes",
    "dev": "node scripts/server.mjs",
    "start": "node scripts/server.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "devDependencies": {
    "assemblyscript": "0.28.20",
    "playwright-core": "1.65.1"
  }
}
