#version 330 core
// PBR fragment shader using the precomputed environment BRDF LUT.
// The LUT stores the GGX normal-distribution + geometry-masking integral:
//   R = scale, G = bias   =>   specularEnv = prefilteredEnv * (F0 * scale + bias)
// Lookup axes: u = NdotV, v = roughness. Bilinear filtering keeps the
// result C0-continuous when roughness changes over time or across pixels.

in vec3 vWorldPos;
in vec3 vNormal;

uniform vec3 uCamPos;
uniform vec3 uBaseColor;
uniform float uMetallic;
uniform float uRoughness;

uniform sampler2D uEnvBRDFLUT;   // generated by brdf_lut, RG (float or unorm)
uniform samplerCube uPrefilteredEnv; // roughness-mipped environment map
uniform float uMaxReflectionLod;

out vec4 fragColor;

const float PI = 3.14159265359;

// Half-texel clamped lookup: texture() with CLAMP_TO_EDGE plus this clamp
// guarantees the coordinates can never leave the texture boundary.
vec2 sampleEnvBRDF(float ndotV, float roughness) {
    vec2 texel = 1.0 / vec2(textureSize(uEnvBRDFLUT, 0));
    vec2 uv = clamp(vec2(ndotV, roughness), 0.5 * texel, 1.0 - 0.5 * texel);
    return texture(uEnvBRDFLUT, uv).rg;
}

// Real-time numerical integration of the same integral (reference path).
// Enable with USE_NUMERIC_REF to visually/numerically compare against the
// LUT path; both must agree to within Monte-Carlo and bilinear error.
#ifdef USE_NUMERIC_REF
float visibilitySmithCorrelated(float ndotV, float ndotL, float roughness);

float radicalInverseVdC(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 integrateEnvBRDF(float ndotV, float roughness, uint sampleCount) {
    ndotV = clamp(ndotV, 1e-4, 1.0);
    vec3 vv = vec3(sqrt(1.0 - ndotV * ndotV), 0.0, ndotV);
    float a = 0.0, b = 0.0;
    for (uint i = 0u; i < sampleCount; ++i) {
        vec2 xi = vec2(float(i) / float(sampleCount), radicalInverseVdC(i));
        float ar = roughness * roughness;
        float phi = 2.0 * PI * xi.x;
        float cosT = sqrt((1.0 - xi.y) / (1.0 + (ar * ar - 1.0) * xi.y));
        float sinT = sqrt(1.0 - cosT * cosT);
        vec3 h = vec3(sinT * cos(phi), sinT * sin(phi), cosT);
        float vdotH = clamp(dot(vv, h), 0.0, 1.0);
        vec3 l = 2.0 * vdotH * h - vv;
        float ndotL = clamp(l.z, 0.0, 1.0);
        float ndotH = clamp(h.z, 0.0, 1.0);
        if (ndotL > 0.0) {
            float vis = visibilitySmithCorrelated(ndotV, ndotL, roughness);
            float gVis = vis * 4.0 * ndotL * vdotH / (ndotH * ndotV + 1e-6);
            float fc = pow(1.0 - vdotH, 5.0);
            a += (1.0 - fc) * gVis;
            b += fc * gVis;
        }
    }
    return vec2(a, b) / float(sampleCount);
}
#endif

// ---- direct-lighting GGX terms (same visibility model as the LUT) ----
float distributionGGX(float ndotH, float roughness) {
    float a = roughness * roughness;
    float a2 = a * a;
    float d = ndotH * ndotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

float visibilitySmithCorrelated(float ndotV, float ndotL, float roughness) {
    float a2 = roughness * roughness * roughness * roughness;
    float gv = ndotL * sqrt(ndotV * ndotV * (1.0 - a2) + a2);
    float gl = ndotV * sqrt(ndotL * ndotL * (1.0 - a2) + a2);
    return 0.5 / (gv + gl + 1e-6);
}

vec3 fresnelSchlick(float cosTheta, vec3 f0) {
    return f0 + (1.0 - f0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

uniform vec3 uLightDir;
uniform vec3 uLightColor;

void main() {
    vec3 n = normalize(vNormal);
    vec3 v = normalize(uCamPos - vWorldPos);
    float roughness = clamp(uRoughness, 0.0, 1.0);
    float ndotV = max(dot(n, v), 0.0);

    vec3 f0 = mix(vec3(0.04), uBaseColor, uMetallic);

    // Direct lighting (numerical evaluation of D * G * F).
    vec3 l = normalize(uLightDir);
    vec3 h = normalize(v + l);
    float ndotL = max(dot(n, l), 0.0);
    vec3 direct = vec3(0.0);
    if (ndotL > 0.0) {
        float d = distributionGGX(max(dot(n, h), 0.0), roughness);
        float vis = visibilitySmithCorrelated(ndotV, ndotL, roughness);
        vec3 f = fresnelSchlick(max(dot(h, v), 0.0), f0);
        vec3 kd = (1.0 - f) * (1.0 - uMetallic);
        direct = kd * uBaseColor / PI * uLightColor * ndotL
               + d * vis * f * uLightColor * ndotL;
    }

    // Image-based specular via the precomputed LUT (split-sum).
    vec3 r = reflect(-v, n);
    vec3 prefiltered = textureLod(uPrefilteredEnv, r, roughness * uMaxReflectionLod).rgb;
#ifdef USE_NUMERIC_REF
    vec2 envBRDF = integrateEnvBRDF(ndotV, roughness, 512u);
#else
    vec2 envBRDF = sampleEnvBRDF(ndotV, roughness);
#endif
    vec3 specularIBL = prefiltered * (f0 * envBRDF.x + envBRDF.y);

    vec3 color = direct + specularIBL;
    fragColor = vec4(color, 1.0);
}
